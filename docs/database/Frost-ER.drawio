        <mxCell id="associations" value="Logical references (no database foreign keys):&#10;sessions.user_id and OAuth user_id columns refer to users.id.&#10;oauth_auth_codes.client_id, oauth_access_tokens.client_id and oauth_device_codes.client_id refer to oauth_clients.id.&#10;oauth_refresh_tokens.access_token_id refers to oauth_access_tokens.id.&#10;oauth_clients.owner_type + owner_id is a polymorphic owner reference.&#10;Refresh-token and device-code tables exist, but their grants are disabled in this app." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#000000;" vertex="1" parent="1">
