          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="PK = primary key     FK = foreign key     UK = unique key     [NULL] = optional column" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="915" width="1560" height="24" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="Each item has one category. A category can have zero or many items. Category deletion is restricted." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="942" width="1560" height="24" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="An audit event has zero or one user. A user can have zero or many audit events. User deletion sets actor_user_id to NULL." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="969" width="1560" height="24" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="audit_events.entity_type + entity_id identifies an item or customer; this is not a foreign key and may refer to a deleted record." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="996" width="1560" height="24" as="geometry" />
        </mxCell>
        <mxCell id="note4" value="users.role = ENUM('owner', 'manager', 'cashier'). Customers are independent of inventory; sales are not stored in this database." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="1023" width="1560" height="24" as="geometry" />
        </mxCell>
