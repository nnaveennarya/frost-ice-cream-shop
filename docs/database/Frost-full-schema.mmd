erDiagram
    categories ||--o{ items : contains
    users |o--o{ audit_events : records
    users |o..o{ sessions : "logical reference"
    users ||..o{ oauth_auth_codes : "logical reference"
    users |o..o{ oauth_access_tokens : "logical reference"
    oauth_clients ||..o{ oauth_auth_codes : "logical reference"
    oauth_clients ||..o{ oauth_access_tokens : "logical reference"
    oauth_clients ||..o{ oauth_device_codes : "logical reference"
    users |o..o{ oauth_device_codes : "logical reference"
    oauth_access_tokens ||..o{ oauth_refresh_tokens : "logical reference"
    audit_events {
        bigint id PK "BIGINT UNSIGNED; required"
        bigint actor_user_id FK "BIGINT UNSIGNED; nullable"
        varchar action "VARCHAR(20); required"
        varchar entity_type "VARCHAR(30); required"
        bigint entity_id "BIGINT UNSIGNED; required"
        char request_id "CHAR(36); required"
        json changed_fields "JSON; required"
        timestamp created_at "TIMESTAMP; required"
    }
    cache {
        varchar key PK "VARCHAR(255); required"
        mediumtext value "MEDIUMTEXT; required"
        bigint expiration "BIGINT; required"
    }
    cache_locks {
        varchar key PK "VARCHAR(255); required"
        varchar owner "VARCHAR(255); required"
        bigint expiration "BIGINT; required"
    }
    categories {
        bigint id PK "BIGINT UNSIGNED; required"
        varchar name UK "VARCHAR(80); required"
        timestamp created_at "TIMESTAMP; nullable"
        timestamp updated_at "TIMESTAMP; nullable"
    }
    customers {
        bigint id PK "BIGINT UNSIGNED; required"
        varchar name "VARCHAR(120); required"
        varchar email "VARCHAR(254); nullable"
        varchar phone "VARCHAR(32); nullable"
        int version "INT UNSIGNED; required"
        timestamp created_at "TIMESTAMP; nullable"
        timestamp updated_at "TIMESTAMP; nullable"
    }
    failed_jobs {
        bigint id PK "BIGINT UNSIGNED; required"
        varchar uuid UK "VARCHAR(255); required"
        varchar connection "VARCHAR(255); required"
        varchar queue "VARCHAR(255); required"
        longtext payload "LONGTEXT; required"
        longtext exception "LONGTEXT; required"
        timestamp failed_at "TIMESTAMP; required"
    }
    items {
        bigint id PK "BIGINT UNSIGNED; required"
        varchar name "VARCHAR(120); required"
        varchar description "VARCHAR(1000); nullable"
        bigint category_id FK "BIGINT UNSIGNED; required"
        decimal price "DECIMAL(10,2); required"
        int quantity "INT UNSIGNED; required"
        int version "INT UNSIGNED; required"
        timestamp created_at "TIMESTAMP; nullable"
        timestamp updated_at "TIMESTAMP; nullable"
    }
    job_batches {
        varchar id PK "VARCHAR(255); required"
        varchar name "VARCHAR(255); required"
        int total_jobs "INT; required"
        int pending_jobs "INT; required"
        int failed_jobs "INT; required"
        longtext failed_job_ids "LONGTEXT; required"
        mediumtext options "MEDIUMTEXT; nullable"
        int cancelled_at "INT; nullable"
        int created_at "INT; required"
        int finished_at "INT; nullable"
    }
    jobs {
        bigint id PK "BIGINT UNSIGNED; required"
        varchar queue "VARCHAR(255); required"
        longtext payload "LONGTEXT; required"
        smallint attempts "SMALLINT UNSIGNED; required"
        int reserved_at "INT UNSIGNED; nullable"
        int available_at "INT UNSIGNED; required"
        int created_at "INT UNSIGNED; required"
    }
    migrations {
        int id PK "INT UNSIGNED; required"
        varchar migration "VARCHAR(255); required"
        int batch "INT; required"
    }
    oauth_access_tokens {
        char id PK "CHAR(80); required"
        bigint user_id "BIGINT UNSIGNED; nullable"
        char client_id "CHAR(36); required"
        varchar name "VARCHAR(255); nullable"
        text scopes "TEXT; nullable"
        tinyint revoked "TINYINT(1); required"
        timestamp created_at "TIMESTAMP; nullable"
        timestamp updated_at "TIMESTAMP; nullable"
        datetime expires_at "DATETIME; nullable"
    }
    oauth_auth_codes {
        char id PK "CHAR(80); required"
        bigint user_id "BIGINT UNSIGNED; required"
        char client_id "CHAR(36); required"
        text scopes "TEXT; nullable"
        tinyint revoked "TINYINT(1); required"
        datetime expires_at "DATETIME; nullable"
    }
    oauth_clients {
        char id PK "CHAR(36); required"
        varchar owner_type "VARCHAR(255); nullable"
        bigint owner_id "BIGINT UNSIGNED; nullable"
        varchar name "VARCHAR(255); required"
        varchar secret "VARCHAR(255); nullable"
        varchar provider "VARCHAR(255); nullable"
        text redirect_uris "TEXT; required"
        text grant_types "TEXT; required"
        tinyint revoked "TINYINT(1); required"
        timestamp created_at "TIMESTAMP; nullable"
        timestamp updated_at "TIMESTAMP; nullable"
    }
    oauth_device_codes {
        char id PK "CHAR(80); required"
        bigint user_id "BIGINT UNSIGNED; nullable"
        char client_id "CHAR(36); required"
        char user_code UK "CHAR(8); required"
        text scopes "TEXT; required"
        tinyint revoked "TINYINT(1); required"
        datetime user_approved_at "DATETIME; nullable"
        datetime last_polled_at "DATETIME; nullable"
        datetime expires_at "DATETIME; nullable"
    }
    oauth_refresh_tokens {
        char id PK "CHAR(80); required"
        char access_token_id "CHAR(80); required"
        tinyint revoked "TINYINT(1); required"
        datetime expires_at "DATETIME; nullable"
    }
    password_reset_tokens {
        varchar email PK "VARCHAR(255); required"
        varchar token "VARCHAR(255); required"
        timestamp created_at "TIMESTAMP; nullable"
    }
    sessions {
        varchar id PK "VARCHAR(255); required"
        bigint user_id "BIGINT UNSIGNED; nullable"
        varchar ip_address "VARCHAR(45); nullable"
        text user_agent "TEXT; nullable"
        longtext payload "LONGTEXT; required"
        int last_activity "INT; required"
    }
    users {
        bigint id PK "BIGINT UNSIGNED; required"
        varchar name "VARCHAR(100); required"
        varchar email UK "VARCHAR(254); required"
        enum role "ENUM('OWNER','MANAGER','CASHIER'); required"
        tinyint is_active "TINYINT(1); required"
        timestamp email_verified_at "TIMESTAMP; nullable"
        varchar password "VARCHAR(255); required"
        varchar remember_token "VARCHAR(100); nullable"
        timestamp created_at "TIMESTAMP; nullable"
        timestamp updated_at "TIMESTAMP; nullable"
    }
