              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Demo Item\",\n  \"description\": \"Synthetic API demonstration record\",\n  \"category_id\": {{category_id}},\n  \"price\": \"275.00\",\n  \"quantity\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const d=pm.response.json().data; pm.environment.set(\"item_id\",d.id); pm.environment.set(\"item_version\",d.version); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Read created item",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/items/{{item_id}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const d=pm.response.json().data; pm.environment.set(\"item_id\",d.id); pm.environment.set(\"item_version\",d.version); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update created item",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/items/{{item_id}}",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Postman Demo Item Updated\",\"version\":{{item_version}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const d=pm.response.json().data; pm.environment.set(\"item_id\",d.id); pm.environment.set(\"item_version\",d.version); }"
                ]
