    {
      "name": "05 Validation and role checks (manual)",
      "item": [
        {
          "name": "Missing bearer token returns 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/items",
            "description": "",
