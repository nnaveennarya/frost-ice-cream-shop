                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "\"{{item_version}}\""
              }
            ],
            "url": "{{base_url}}/api/items/{{item_id}}",
            "description": "Deletes the demo record created earlier in this folder. Do not replace its ID with a real customer or stock record."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
