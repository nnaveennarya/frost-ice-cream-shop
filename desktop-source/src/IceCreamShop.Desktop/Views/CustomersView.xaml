<UserControl x:Class="IceCreamShop.Desktop.Views.CustomersView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:behavior="clr-namespace:IceCreamShop.Desktop.Services.Presentation">
 <Grid MinWidth="690">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <Button DockPanel.Dock="Right" Content="+ New customer" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding CanCreate, Converter={StaticResource BoolVisibility}}"/>
   <StackPanel><TextBlock Text="Customers" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Good service starts with knowing your customers." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
  </DockPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,18">
   <Button DockPanel.Dock="Right" Content="_Reload" Command="{Binding RefreshCommand}" Margin="10,0,0,0"/>
   <TextBlock Text="Customer directory" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
  </DockPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="18"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedItem}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" AutomationProperties.Name="Customers records"><DataGrid.Columns>
      <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Name" Binding="{Binding Name}" Width="*" MinWidth="180"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Email" Binding="{Binding Email}" Width="*" MinWidth="170"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Phone" Binding="{Binding Phone}" Width="120"/>
     </DataGrid.Columns></DataGrid>
     <DockPanel Grid.Row="1" Margin="12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" AutomationProperties.Name="Previous page" Command="{Binding PreviousCommand}" Padding="12,5"/><Button Content="›" AutomationProperties.Name="Next page" Command="{Binding NextCommand}" Padding="12,5" Margin="6,0,0,0"/></StackPanel>
      <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"/>
     </DockPanel>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel behavior:ValidationFocus.Status="{Binding Status}">
      <TextBlock Text="customer details" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="A name is required. Contact details are optional." Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
      <StackPanel IsEnabled="{Binding CanEditFields}">
       <Label Content="_Name *" Target="{Binding ElementName=NameInput}"/>
<TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Name" />
<TextBlock Text="{Binding NameError}" Style="{StaticResource FieldError}"/><Label Content="_Email" Target="{Binding ElementName=EmailInput}"/>
<TextBox x:Name="EmailInput" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" AutomationProperties.Name="Email" />
<TextBlock Text="{Binding EmailError}" Style="{StaticResource FieldError}"/><Label Content="_Phone" Target="{Binding ElementName=PhoneInput}"/>
<TextBox x:Name="PhoneInput" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" AutomationProperties.Name="Phone" />
<TextBlock Text="{Binding PhoneError}" Style="{StaticResource FieldError}"/>
       <Button Content="Save customer" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"/>
       <Button Content="Delete customer" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,10,0,0" Visibility="{Binding CanDelete, Converter={StaticResource BoolVisibility}}"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,14,0,0">
   <ProgressBar IsIndeterminate="True" Height="3" Foreground="{StaticResource Accent}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Grid>
</UserControl>
