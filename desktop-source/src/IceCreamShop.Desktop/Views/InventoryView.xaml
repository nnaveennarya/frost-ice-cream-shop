<UserControl x:Class="IceCreamShop.Desktop.Views.InventoryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:behavior="clr-namespace:IceCreamShop.Desktop.Services.Presentation">
 <Grid MinWidth="690">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <Button DockPanel.Dock="Right" Content="+ New item" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding CanCreate, Converter={StaticResource BoolVisibility}}"/>
   <StackPanel><TextBlock Text="Inventory" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Keep every flavor accounted for." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
  </DockPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,18">
   <Button DockPanel.Dock="Right" Content="_Reload" Command="{Binding RefreshCommand}" Margin="10,0,0,0"/>
   <Button DockPanel.Dock="Right" Content="_Search" Command="{Binding SearchCommand}" Margin="10,0,0,0"/>
 <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Search inventory by name" ToolTip="Search by item name"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox>
  </DockPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="18"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedItem}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" AutomationProperties.Name="Inventory records"><DataGrid.Columns>
      <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Item" Binding="{Binding Name}" Width="2*" MinWidth="180"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Flavor" Binding="{Binding Category.Name}" Width="*" MinWidth="110"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="LKR" Binding="{Binding Price}" Width="100"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Stock" Binding="{Binding Quantity}" Width="90"/>
     </DataGrid.Columns></DataGrid>
     <DockPanel Grid.Row="1" Margin="12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" AutomationProperties.Name="Previous page" Command="{Binding PreviousCommand}" Padding="12,5"/><Button Content="›" AutomationProperties.Name="Next page" Command="{Binding NextCommand}" Padding="12,5" Margin="6,0,0,0"/></StackPanel>
      <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"/>
     </DockPanel>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel behavior:ValidationFocus.Status="{Binding Status}">
      <TextBlock Text="item details" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="Select a row to edit, or choose New item." Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
      <StackPanel IsEnabled="{Binding CanEditFields}">
       <Label Content="_Name *" Target="{Binding ElementName=NameInput}"/>
<TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Name" />
<TextBlock Text="{Binding NameError}" Style="{StaticResource FieldError}"/><Label Content="_Flavor *" Target="{Binding ElementName=CategoryInput}"/><ComboBox x:Name="CategoryInput" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name" AutomationProperties.Name="Flavor"/><TextBlock Text="{Binding CategoryError}" Style="{StaticResource FieldError}"/><Label Content="_Price (LKR) *" Target="{Binding ElementName=PriceInput}"/>
<TextBox x:Name="PriceInput" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" AutomationProperties.Name="Price (LKR)" />
<TextBlock Text="{Binding PriceError}" Style="{StaticResource FieldError}"/><Label Content="_Quantity *" Target="{Binding ElementName=QuantityInput}"/>
<TextBox x:Name="QuantityInput" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Quantity" />
<TextBlock Text="{Binding QuantityError}" Style="{StaticResource FieldError}"/><Label Content="_Description" Target="{Binding ElementName=DescriptionInput}"/>
<TextBox x:Name="DescriptionInput" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AutomationProperties.Name="Description" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72" MaxHeight="180" VerticalScrollBarVisibility="Auto"/>
<TextBlock Text="{Binding DescriptionError}" Style="{StaticResource FieldError}"/>
       <Button Content="Save item" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"/>
       <Button Content="Delete item" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,10,0,0" Visibility="{Binding CanDelete, Converter={StaticResource BoolVisibility}}"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,14,0,0">
   <ProgressBar IsIndeterminate="True" Height="3" Foreground="{StaticResource Accent}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Grid>
</UserControl>
