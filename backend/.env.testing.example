# Disposable MySQL tests only. Supply private credentials locally or through CI.
APP_NAME="Frost Shop Tests"
APP_ENV=testing
# Generate a distinct key with: php artisan key:generate --env=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ice_cream_assessment_test
DB_USERNAME=ice_migrate
DB_PASSWORD=
HASH_DRIVER=argon2id
SESSION_DRIVER=array
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
LOG_CHANNEL=single
LOG_LEVEL=warning
# APP_ENV=testing selects the isolated storage/oauth-testing signing-key directory.
# Create it, then run: php artisan passport:keys --env=testing --no-interaction
